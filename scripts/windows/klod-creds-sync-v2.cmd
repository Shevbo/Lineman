@echo off
rem ============================================================================
rem  klod-creds-sync-v2.cmd — перенос учётных данных Claude с Windows на smain.
rem
rem  Что изменилось против v1: убрана локальная проверка срока через python.
rem  В v1 она была вставлена внутрь `for /f` и ломалась на кавычках и скобках —
rem  cmd выдавал «))['claudeAiOauth'] was unexpected at this time». Срок всё равно
rem  печатает сервер в строке ГОТОВ/ПРОПУСК, так что локальная проверка была
rem  удобством, которое стоило работоспособности.
rem
rem  Зачем всё это. С smain вход на claude.ai невозможен: Cloudflare блокирует наш
rem  IP. refreshToken при обновлении НЕ продлевается, поэтому раз в несколько недель
rem  вход делается здесь, под VPN, а результат переносится на сервер.
rem
rem  ВАЖНО про /logout: он разлогинивает и Claude Code в VS Code — файл учётных
rem  данных у них общий. Для обновления достаточно /login, выходить не нужно.
rem ============================================================================
chcp 65001 >nul 2>&1
setlocal
title Клод — перенос учётных данных на smain

set "CREDS=%USERPROFILE%\.claude\.credentials.json"
set "REMOTE=smain"

echo.
echo ================================================================
echo   Перенос учётных данных Claude на smain
echo ================================================================
echo.

rem ------------------------------------------------------------- 1. файл на месте
if not exist "%CREDS%" (
    echo [X] Нет файла учётных данных:
    echo     %CREDS%
    echo.
    echo     Claude Code на этой машине не авторизован. Запусти "claude",
    echo     выполни "/login" и кликни ярлык снова.
    goto :end
)
echo   Файл учётных данных найден.

rem --------------------------------------------------------- 2. связь с сервером
echo   Проверяю связь с сервером %REMOTE%...
ssh -o ConnectTimeout=10 -o BatchMode=yes %REMOTE% "echo ok" >nul 2>&1
if errorlevel 1 (
    echo.
    echo [X] Сервер %REMOTE% недоступен по ssh.
    echo     Чаще всего это значит, что не поднят VPN. Подними и повтори.
    goto :end
)
echo   Связь есть.
echo.

rem ------------------------------------------------------------------ 3. перенос
echo   Переношу, сервер сам сверит сроки...
echo ----------------------------------------------------------------
type "%CREDS%" | ssh %REMOTE% "bin/install-claude-creds.sh"
set RC=%ERRORLEVEL%
echo ----------------------------------------------------------------
echo.

rem -------------------------------------------------------------- 4. разбор итога
if "%RC%"=="0" goto :ok
echo [!] Код возврата %RC%.
echo.
echo     Если выше есть ПРОПУСК — здешний токен не новее серверного, его не
echo     приняли намеренно, чтобы не откатить рабочие данные назад. Запусти
echo     "claude", выполни "/login" (БЕЗ /logout — он разлогинит VS Code),
echo     затем кликни ярлык снова.
echo.
echo     Если есть УСТАНОВЛЕНО, а потом ПРОВЕРКА НЕ ПРОШЛА — данные легли
echo     верно, просто модель была занята. Делать ничего не надо.
echo.
echo     В остальных случаях скопируй вывод выше и пришли Клоду.
goto :end

:ok
echo [OK] Готово. Выше строка ГОТОВ или УСТАНОВЛЕНО с новыми сроками.
echo.
echo      Если написано ПРОПУСК — значит на сервере данные уже свежее
echo      здешних, и переносить было нечего. Это нормально.

:end
echo.
echo ================================================================
pause
endlocal
