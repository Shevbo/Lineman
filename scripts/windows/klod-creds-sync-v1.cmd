@echo off
rem ============================================================================
rem  klod-creds-sync-v1.cmd — перенос учётных данных Claude с Windows на smain.
rem
rem  Зачем. С smain вход на claude.ai невозможен: Cloudflare блокирует наш IP.
rem  refreshToken при обновлении НЕ продлевается, поэтому раз в несколько недель
rem  вход выполняется здесь, под VPN, а результат переносится на сервер.
rem  Без этого Клод замолкает для всей федерации, и починить это с сервера нельзя.
rem
rem  Как пользоваться: подними VPN, кликни по ярлыку. Остальное скрипт сделает сам
rem  и объяснит, если что-то нужно от тебя.
rem
rem  Версия в имени файла намеренно: когда пришлю новую, старый ярлык не перепутается.
rem ============================================================================
chcp 65001 >nul 2>&1
setlocal enabledelayedexpansion
title Клод — перенос учётных данных на smain

set "CREDS=%USERPROFILE%\.claude\.credentials.json"
set "REMOTE=smain"

echo.
echo ================================================================
echo   Перенос учётных данных Claude на smain
echo ================================================================
echo.

rem ---------------------------------------------------------------- 1. файл есть
if not exist "%CREDS%" (
    echo [X] Не нашёл файл учётных данных:
    echo     %CREDS%
    echo.
    echo     Значит Claude Code на этой машине не авторизован.
    echo     Запусти "claude", выполни "/login", потом снова кликни этот ярлык.
    goto :end
)

rem ------------------------------------------------- 2. срок локального токена
for /f "usebackq delims=" %%D in (`python -c "import json,os,datetime;d=json.load(open(os.path.expanduser(r'%CREDS%')))['claudeAiOauth'];print(datetime.datetime.fromtimestamp(d['refreshTokenExpiresAt']/1000).strftime('%%Y-%%m-%%d %%H:%%M'))" 2^>nul`) do set "LOCAL_EXP=%%D"

if "%LOCAL_EXP%"=="" (
    echo [!] Не смог прочитать срок из файла — возможно, нет python или файл повреждён.
    echo     Продолжаю: решение примет сервер, он проверит то же самое.
    echo.
) else (
    echo   Здесь, на Windows: refreshToken живёт до %LOCAL_EXP%
)

rem ------------------------------------------------------- 3. связь с сервером
echo   Проверяю связь с сервером...
ssh -o ConnectTimeout=10 -o BatchMode=yes %REMOTE% "echo ok" >nul 2>&1
if errorlevel 1 (
    echo.
    echo [X] Сервер %REMOTE% недоступен по ssh.
    echo.
    echo     Чаще всего это значит, что не поднят VPN. Подними его и повтори.
    echo     Если VPN поднят — напиши Клоду, проверю со своей стороны.
    goto :end
)
echo   Связь есть.
echo.

rem --------------------------------------------------------------- 4. перенос
echo   Переношу...
echo ----------------------------------------------------------------
type "%CREDS%" | ssh %REMOTE% "bin/install-claude-creds.sh"
set "RC=%ERRORLEVEL%"
echo ----------------------------------------------------------------
echo.

rem ------------------------------------------------------------- 5. разбор итога
if "%RC%"=="0" (
    echo [OK] Готово. Выше видно строку УСТАНОВЛЕНО и новые сроки.
    echo.
    echo      Если там написано ПРОПУСК — значит на сервере лежит токен
    echo      СВЕЖЕЕ здешнего, и переносить нечего. Это нормально.
    echo      Чтобы обновить: запусти "claude", выполни "/logout", затем
    echo      "/login", и кликни ярлык снова.
) else (
    echo [!] Перенос завершился с кодом %RC%.
    echo.
    echo     Код 1 — сервер отказался ставить эти данные. Самая частая причина:
    echo     здешний токен старее серверного, его не приняли намеренно, чтобы не
    echo     откатить рабочие учётные данные назад. Сделай "/logout" и "/login"
    echo     в claude, затем повтори.
    echo.
    echo     Если в выводе есть строка УСТАНОВЛЕНО, а потом ПРОВЕРКА НЕ ПРОШЛА —
    echo     данные легли верно, просто модель была занята. Ничего делать не надо.
    echo.
    echo     В остальных случаях скопируй вывод выше и пришли Клоду.
)

:end
echo.
echo ================================================================
pause
endlocal
